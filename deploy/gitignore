# Installed on the server once with `npm ci --omit=dev`, never committed:
# it contains platform-specific binaries (this machine is arm64, cPanel is x64).
node_modules/

# Written at runtime by the server (ISR / fetch cache). Committing it would
# make every `git pull` on cPanel conflict.
.next/cache/

# Runtime secrets live in the cPanel Node.js app's environment variables.
.env*

# Generated by cPanel when the Node.js app is set up (Passenger directives) and
# edited on the server. It belongs to the host, not to the build — committing it
# would overwrite the server's copy on every pull.
.htaccess

npm-debug.log*
.DS_Store
