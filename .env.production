# Production build values.
#
# These are read by `npm run build` (and by scripts/build-deploy.sh). Every
# NEXT_PUBLIC_* value below is inlined into the client bundle at build time —
# changing it on the server has no effect, the site must be rebuilt.
#
# Dev overrides live in .env.development.local so they can never leak into a
# production build.

NEXT_PUBLIC_SITE_URL=https://h2solutions.az
NEXT_PUBLIC_API_URL=https://api.h2solutions.az/api

# Optional: external hero video URL (overrides local public/videos/hero.mp4)
NEXT_PUBLIC_HERO_VIDEO_URL=https://admin.jis.az/uploads/short_web_be3503227f.mp4

# REVALIDATE_SECRET is read at request time, not build time — set it in the
# cPanel Node.js app's environment variables, not here.
